# Copia este fichero a .devcontainer/.env y rellena solo lo que necesites. El
# compose arranca sin él: entonces solo responde el modelo `mock` y los secretos
# son los de desarrollo. Nunca commitees ningún fichero `.env`.

# --- OpenAI (para veredictos reales) ---
OPENAI_API_KEY=
ANALYSIS_MODEL=mock
# Cambia la línea anterior por esta al configurar una clave real:
# ANALYSIS_MODEL=gpt-5.6-terra

# --- Puertos publicados en el host (evitan choques con otros devcontainers) ---
# El gateway se sirve cuando está activo el perfil `services`.
GATEWAY_PORT=7777
KNOWLEDGE_PORT=8400
LITELLM_PORT=4100
SURREAL_PORT=8100
SURREALIST_PORT=8200

# --- SurrealDB ---
SURREAL_ROOT_PASSWORD=root
SURREAL_AGENT_PASSWORD=agent-dev-password
SURREAL_RUNTIME_PASSWORD=runtime-dev-password
SURREAL_GATEWAY_PASSWORD=gateway-dev-password

# --- LiteLLM ---
# El master key debe empezar por sk-.
LITELLM_MASTER_KEY=sk-argos-master-key
