{
  "name": "Argos",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "runServices": [
    "app",
    "gateway",
    "dispatcher",
    "worker",
    "resumer",
    "analyzer",
    "janitor",
    "surrealdb-test",
    "nats-test"
  ],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "forwardPorts": [7777, 8400, 4100, 3200, 8100, 8200],
  "portsAttributes": {
    "7777": { "label": "AgentOS", "onAutoForward": "notify" },
    "8400": { "label": "Knowledge graph", "onAutoForward": "notify" },
    "4100": { "label": "LiteLLM", "onAutoForward": "silent" },
    "3200": { "label": "Langfuse", "onAutoForward": "silent" },
    "8100": { "label": "SurrealDB", "onAutoForward": "silent" },
    "8200": { "label": "Surrealist", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "surrealdb.surrealql"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "editor.formatOnSave": true,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  }
}
